{ "timestamp":"2025-02-27T21:38:41Z", "event":"ReceiveText", "From":"smubp", "Message":"yeah we are prettymuch allied with them", "Channel":"player" }
{ "timestamp":"2025-02-27T21:38:45Z", "event":"ReceiveText", "From":"smubp", "Message":"we despise felicia winters", "Channel":"player" }
{ "timestamp":"2025-02-27T21:38:52Z", "event":"ReceiveText", "From":"smubp", "Message":"almost everyone in our squadron is imperial pledged lol", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:00Z", "event":"SendText", "To":"smubp", "Message":"I cannot stand anything that says 'felicia winters' on it", "Sent":true }
{ "timestamp":"2025-02-27T21:39:05Z", "event":"ReceiveText", "From":"smubp", "Message":"us neither", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:09Z", "event":"ReceiveText", "From":"smubp", "Message":"thats why we went to war", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:13Z", "event":"ReceiveText", "From":"smubp", "Message":"but FLC kinda took nugua", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:17Z", "event":"ReceiveText", "From":"smubp", "Message":"we've had a big war", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:18Z", "event":"ReceiveText", "From":"smubp", "Message":"since then", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:26Z", "event":"ReceiveText", "From":"smubp", "Message":"intercepting and destroying FLC powerplay commanders in the region", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:27Z", "event":"ReceiveText", "From":"smubp", "Message":"so", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:29Z", "event":"ReceiveText", "From":"smubp", "Message":"if you like that", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:33Z", "event":"ReceiveText", "From":"smubp", "Message":"and you like colonising together", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:42Z", "event":"ReceiveText", "From":"smubp", "Message":"even your quad truss coriolis station at Antliae Sector YE-R b4-7", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:48Z", "event":"ReceiveText", "From":"smubp", "Message":"come join our discord for a little cooperation", "Channel":"player" }
{ "timestamp":"2025-02-27T21:39:49Z", "event":"SendText", "To":"smubp", "Message":"I don't really do the PVP thing, other than getting murdered", "Sent":true }
{ "timestamp":"2025-02-27T21:40:02Z", "event":"ReceiveText", "From":"smubp", "Message":"we dont need  you to do pvp lol", "Channel":"player" }
{ "timestamp":"2025-02-27T21:40:09Z", "event":"ReceiveText", "From":"smubp", "Message":"we just run this region", "Channel":"player" }
{ "timestamp":"2025-02-27T21:40:19Z", "event":"ReceiveText", "From":"smubp", "Message":"youve expanded from our faction, we wish to support all those who do", "Channel":"player" }
{ "timestamp":"2025-02-27T21:40:36Z", "event":"ReceiveText", "From":"smubp", "Message":"and if youre federal- we will condemn and sabotage your colonisation projects", "Channel":"player" }
{ "timestamp":"2025-02-27T21:40:36Z", "event":"SendText", "To":"smubp", "Message":"I would always welcome the help of your faction in finishing the port, if you want to get your team involved in contributions, I would not mind. I myself am currently working on running mats.", "Sent":true }
{ "timestamp":"2025-02-27T21:40:55Z", "event":"ReceiveText", "From":"smubp", "Message":"again go ahead and join the discord", "Channel":"player" }
