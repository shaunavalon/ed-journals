{ "timestamp":"2025-02-27T21:37:52Z", "event":"ReceiveText", "From":"smubp", "Message":"and wanna get good with our neighbours from the get go", "Channel":"player" }
{ "timestamp":"2025-02-27T21:38:03Z", "event":"SendText", "To":"smubp", "Message":"I am totally not against you guys", "Sent":true }
{ "timestamp":"2025-02-27T21:38:04Z", "event":"ReceiveText", "From":"smubp", "Message":"so would be real lovely if you joined our discord", "Channel":"player" }
{ "timestamp":"2025-02-27T21:38:13Z", "event":"ReceiveText", "From":"smubp", "Message":"we are totally not against you lol", "Channel":"player" }
{ "timestamp":"2025-02-27T21:38:17Z", "event":"SendText", "To":"smubp", "Message":"I can, but my loyalty is to the Angels as well", "Sent":true }
{ "timestamp":"2025-02-27T21:38:23Z", "event":"ReceiveText", "From":"smubp", "Message":"angels?", "Channel":"player" }
