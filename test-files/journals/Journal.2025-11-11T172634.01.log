{ "timestamp":"2025-11-11T16:47:20Z", "event":"ReceiveText", "From":"kzr77", "Message":"Hey Nemesis! I think I have it handled. There was a Python II targeting me in the system. But I wasn't going to make it easy on him with running away. ", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:47:41Z", "event":"ReceiveText", "From":"7b7je", "Message":"Still moving my krait to cherno", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:47:42Z", "event":"ReceiveText", "From":"kzr77", "Message":"Stayed on his nose the whole time lol. ", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:48:30Z", "event":"ReceiveText", "From":"kzr77", "Message":"Oh I'm in Cheranovsky City. Trying to put in a little more relics to our PP list. ", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:48:31Z", "event":"ReceiveText", "From":"7b7je", "Message":"gonna move my krait and you just put out the call if you need help", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:48:37Z", "event":"ReceiveText", "From":"7b7je", "Message":"same", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:49:21Z", "event":"ReceiveText", "From":"7b7je", "Message":"20 mins and my krait will be here. It's decked for pvp", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:49:34Z", "event":"ReceiveText", "From":"7b7je", "Message":"so ill hop over to open and give em the smack down if you need help", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:49:59Z", "event":"ReceiveText", "From":"7b7je", "Message":"but remember that it wont be here for 20", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:50:09Z", "event":"ReceiveText", "From":"kzr77", "Message":"Lol sounds good thanks for having my back. ", "Channel":"squadron" }
{ "timestamp":"2025-11-11T16:50:31Z", "event":"ReceiveText", "From":"kzr77", "Message":"I'll send the alarm should we need to chase him off. I have my Python II here too. ", "Channel":"squadron" }
