{ "timestamp":"2025-03-23T16:37:07Z", "event":"ReceiveText", "From":"swmm7", "Message":"Alright! Just performed my first assistance-free docking!", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:37:21Z", "event":"ReceiveText", "From":"qt56a", "Message":"excellent!", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:37:27Z", "event":"ReceiveText", "From":"9cty2", "Message":"congrats", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:37:42Z", "event":"SendText", "To":"squadron", "Message":"nice!", "Sent":true }
{ "timestamp":"2025-03-23T16:37:43Z", "event":"ReceiveText", "From":"jwnqw", "Message":"now it's time for the mail slot speed camera record", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:37:52Z", "event":"SendText", "To":"squadron", "Message":"lol", "Sent":true }
{ "timestamp":"2025-03-23T16:38:03Z", "event":"ReceiveText", "From":"y3xqb", "Message":"I tried that in d20 station - never again x_x", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:38:41Z", "event":"SendText", "To":"squadron", "Message":"manual docking, in many ships, is faster, and if you have shields you can pretty much just hammer onto the pad quite hard and fast and its not an issue. i kinda just mash my bigger ships into the pads because im lazy", "Sent":true }
{ "timestamp":"2025-03-23T16:38:56Z", "event":"Friends", "Status":"Online", "Name":"vz6vq" }
{ "timestamp":"2025-03-23T16:39:13Z", "event":"ReceiveText", "From":"qt56a", "Message":"i have a particular disclike for docking large ships because of this lol", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:39:17Z", "event":"ReceiveText", "From":"jwnqw", "Message":"i'm just more important and i'm not waiting in queue", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:39:18Z", "event":"ReceiveText", "From":"qt56a", "Message":"*dislike", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:39:49Z", "event":"SendText", "To":"squadron", "Message":"yeah i'm not queueing. if i'm in my type 9 i dont care whats in the slot ill just crush over it lmao", "Sent":true }
{ "timestamp":"2025-03-23T16:40:30Z", "event":"SendText", "To":"squadron", "Message":"though its nice to autodock when afk playing and just cruise assist dock assist and grind", "Sent":true }
{ "timestamp":"2025-03-23T16:40:43Z", "event":"ReceiveText", "From":"y3xqb", "Message":"but you can get into shreds if you get stuck =\\", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:41:19Z", "event":"SendText", "To":"squadron", "Message":"yes =) you can get stuck", "Sent":true }
{ "timestamp":"2025-03-23T16:41:26Z", "event":"ReceiveText", "From":"jwnqw", "Message":"i also just like the optics of slidding through the door sideways at 400m/s", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:41:35Z", "event":"ReceiveText", "From":"swmm7", "Message":"It wasnt as bad as I thought it would be", "Channel":"squadron" }
{ "timestamp":"2025-03-23T16:41:57Z", "event":"SendText", "To":"squadron", "Message":"just keep doing it - it gets easier with practice", "Sent":true }
