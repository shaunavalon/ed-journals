{ "timestamp":"2026-07-29T16:37:14Z", "event":"ReceiveText", "From":"sn6d2", "Message":"yea we had to use smoke signals at the beginning", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:37:22Z", "event":"ReceiveText", "From":"sn6d2", "Message":"do you have any idea how hard smoke signals are in space?", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:37:40Z", "event":"ReceiveText", "From":"yt8x4", "Message":"I'm sure firing would have been much more efficient", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:37:53Z", "event":"ReceiveText", "From":"yt8x4", "Message":"Gets your hatred across", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:37:54Z", "event":"ReceiveText", "From":"4qddg", "Message":"making smoke go straight up was real hard", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:38:05Z", "event":"ReceiveText", "From":"yt8x4", "Message":"But which way is up?", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:38:14Z", "event":"ReceiveText", "From":"yt8x4", "Message":"Which way is down?", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:38:18Z", "event":"ReceiveText", "From":"yt8x4", "Message":"where am i?", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:38:24Z", "event":"ReceiveText", "From":"sn6d2", "Message":"you're down", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:38:28Z", "event":"ReceiveText", "From":"sn6d2", "Message":"or going there, at least", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:38:33Z", "event":"ReceiveText", "From":"sn6d2", "Message":"so the NPCs keep telling me", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:38:56Z", "event":"Music", "MusicTrack":"Starport" }
{ "timestamp":"2026-07-29T16:39:19Z", "event":"ReceiveText", "From":"dp5my", "Message":"Enjoy, will be here tomorrow if the CG starts", "Channel":"starsystem" }
{ "timestamp":"2026-07-29T16:42:06Z", "event":"ReceiveText", "From":"yt8x4", "Message":"Texting and driving is easier than I thought. Just a minor crash!", "Channel":"starsystem" }
