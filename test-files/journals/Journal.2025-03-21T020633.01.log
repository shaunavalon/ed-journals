{ "timestamp":"2025-03-21T01:29:19Z", "event":"ReceiveText", "From":"q7cqp", "Message":"I'm just buying stuff and taking it to my colony.", "Channel":"starsystem" }
{ "timestamp":"2025-03-21T01:29:24Z", "event":"ReceiveText", "From":"9k2ng", "Message":"He's loving it and using bgs state to make an excuse for jumping haulers when he doesn;t need one. lol. ", "Channel":"starsystem" }
